# Frontend Docker builds use `context: frontend`, so the repo-root .dockerignore
# does not protect this context. Keep local build output, dependencies, and
# environment files out of GHCR image builds.

# Dependencies and package-manager state
node_modules
.pnpm-store

# Next.js/build/test output
.next
.next-dev
.turbo
.vercel
coverage
test-results
playwright-report
*.tsbuildinfo

# Local env and secrets
.env
.env.*

# Caches and logs
.cache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# VCS, editor, OS
.git
.github
.DS_Store
.idea
.vscode
