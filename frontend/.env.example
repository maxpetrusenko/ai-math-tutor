NEXT_PUBLIC_SESSION_WS_URL=ws://127.0.0.1:8000/ws/session

# Lessons API base URL. When unset, it is derived from NEXT_PUBLIC_SESSION_WS_URL
# (same host, http/https scheme matched to ws/wss). Hosted builds where the
# frontend and session API are separate origins set it explicitly, e.g.
# https://aitutor-session.maxpetrusenko.com/api/lessons
NEXT_PUBLIC_LESSON_API_URL=

# Leave unset for live sessions; set to "fixture" to run the scripted demo
# transport (used by Playwright runs, see playwright.config.ts).
NEXT_PUBLIC_SESSION_TRANSPORT=
