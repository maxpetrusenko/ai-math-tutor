BACKEND_PORT=8000
FRONTEND_PORT=3000
HOST=127.0.0.1
NERDY_AI_LOG_PATH=.nerdy-data/ai-calls.jsonl
NERDY_ENABLE_LANGSMITH=0
NERDY_STT_PROVIDER=deepgram
NERDY_LLM_PROVIDER=minimax
NERDY_LLM_FALLBACK_PROVIDER=gemini
NERDY_RUNTIME_LLM_PROVIDER=gemini
NERDY_RUNTIME_LLM_FALLBACK_PROVIDER=minimax
# Live-path overrides: runtime TTS shaping + per-call network budgets (seconds).
# LLM budget note: the gemini live lane defaults to 10 s and raises smaller
# values to a 10 s floor; langchain-based lanes default to 4 s when unset.
NERDY_RUNTIME_TTS_MODEL=sonic-2
NERDY_RUNTIME_TTS_SAMPLE_RATE=22050
NERDY_RUNTIME_TTS_LANGUAGE=en
NERDY_LIVE_LLM_TIMEOUT_SECONDS=10
NERDY_LIVE_TTS_TIMEOUT_SECONDS=4
# Set to 1 to disable live provider calls (exercise fixture/stub paths only)
NERDY_DISABLE_LIVE_LLM=0
NERDY_DISABLE_LIVE_TTS=0
DEEPGRAM_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
MINIMAX_API_KEY=
NERDY_TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
# Optional TTS voice-id overrides (provider defaults are used when unset)
# NERDY_TTS_VOICE_CARTESIA=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
# NERDY_TTS_VOICE_MINIMAX=
NERDY_AVATAR_PROVIDER=talkinghead
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIMLI_API_KEY=
SIMLI_FACE_ID=
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Set to 1 to point LiveAvatar managed avatars at provider sandbox endpoints
LIVEAVATAR_IS_SANDBOX=0
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
NERDY_LIVEKIT_OPENAI_VOICE=alloy
NERDY_LIVEKIT_AGENT_INSTRUCTIONS=Talk to me like a clear, encouraging tutor.
# Optional first line spoken when a managed LiveKit agent session starts
NERDY_LIVEKIT_OPENING_LINE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_PROJECT=nerdy
LANGCHAIN_PROJECT=nerdy
LANGCHAIN_TRACING_V2=false

# Provider module discovery (advanced; effective defaults shown)
# STT_MODULES=backend.providers.stt.deepgram
# TTS_MODULES=backend.providers.tts.cartesia,backend.providers.tts.minimax
# LLM_MODULES=backend.providers.llm.minimax,backend.providers.llm.gemini,backend.providers.llm.openai,backend.providers.llm.anthropic
# AVATAR_MODULES=backend.providers.avatar.talkinghead

# STT Providers: deepgram, elevenlabs, google
# LLM Providers: minimax, gemini, openai, anthropic
# TTS Providers: cartesia, elevenlabs, google, azure
# Avatar Providers: talkinghead
# Managed avatar room path: LiveKit + Simli / LiveAvatar
# Hosted note: keep OPENAI_API_KEY populated for prod/staging. The default session UI uses OpenAI Realtime even when the backend lesson path uses other LLM providers.
# LangSmith aliases accepted: LANGCHAIN_API_KEY, LANGCHAIN_PROJECT, LANGCHAIN_TRACING_V2
# Gemini key aliases accepted: GEMINI_API_KEY, GOOGLE_AI_API_KEY
